<view class="page"><view class="title">消息中心</view><view class="muted">课程动态与审批结果</view><view wx:for="{{items}}" wx:key="id" class="card gap" data-id="{{item.id}}" bindtap="read"><view class="subtitle"><text wx:if="{{!item.read}}" class="unread"/>{{item.title}}</view><view class="muted gap">{{item.body}}</view><view class="muted gap">{{item.time}}</view></view><view wx:if="{{!items.length}}" class="empty">暂无消息</view></view><role-nav role="{{role}}" active="messages"/>
