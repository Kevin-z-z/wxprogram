<view class="page"><view class="title">我的课表</view><view class="muted">按课次查看上课安排和考勤</view><view wx:for="{{sessions}}" wx:key="id" class="card gap" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="tag">{{item.date}}</text><text class="muted">{{item.settled?'已结算':'未结算'}}</text></view><view class="subtitle gap">{{item.courseName}}</view><view class="muted gap">{{item.time}} · {{item.location}}</view><view class="row split"><text>{{item.teacher}} · {{item.hours}} 课时</text><text>{{role==='parent'?item.studentStatus:item.activityLabel}} →</text></view></view><view wx:if="{{!sessions.length}}" class="empty">暂无课程安排</view></view><role-nav role="{{role}}" active="schedule"/>
