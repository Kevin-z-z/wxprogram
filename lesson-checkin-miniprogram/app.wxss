page{background:#f5f7fa;color:#213047;font-size:28rpx;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}view,text,button,input,textarea{box-sizing:border-box}button::after{border:0}button{font-size:27rpx;border-radius:18rpx;margin:0;background:#eaf0f8;color:#28496b;line-height:2.6}button[disabled]{opacity:.45}button.primary{background:#226ae4;color:#fff}button.danger{background:#fff0ef;color:#bd403b}button.small{font-size:23rpx;padding:0 20rpx;line-height:2.3}.page{padding:30rpx 30rpx calc(150rpx + env(safe-area-inset-bottom))}.hero{background:#163e71;color:white;border-radius:28rpx;padding:34rpx;margin-bottom:26rpx}.hero .muted{color:#c6d8f1}.title{font-size:40rpx;font-weight:700;margin-bottom:12rpx}.subtitle{font-size:30rpx;font-weight:650}.muted{font-size:25rpx;color:#7b8798;line-height:1.6}.section{font-size:30rpx;font-weight:650;margin:30rpx 0 18rpx}.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:22rpx;border:1rpx solid #e9edf3}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.stack button,.stack .subtitle,.stack .muted{margin-bottom:16rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.grid .card{margin-bottom:0}.number{font-size:50rpx;font-weight:750;margin:14rpx 0}.tag{display:inline-block;font-size:22rpx;padding:5rpx 14rpx;border-radius:20rpx;background:#eaf2ff;color:#226ae4}.tag.green{background:#e5f6ef;color:#198364}.gap{margin-top:20rpx}.empty{text-align:center;color:#8391a4;padding:70rpx 10rpx}.field{margin:22rpx 0}.label{font-size:26rpx;font-weight:600;margin-bottom:12rpx}input,textarea,.picker{width:100%;border-radius:14rpx;background:#f4f6f9;padding:22rpx;min-height:86rpx}textarea{height:170rpx}.actions{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:18rpx}.notice{font-size:25rpx;line-height:1.6;color:#667992;margin:20rpx 0}.photo{width:100%;height:360rpx;border-radius:18rpx}.split{padding-top:22rpx;margin-top:22rpx;border-top:1rpx solid #eef1f6}.selected{background:#226ae4!important;color:white!important}.pill{font-size:23rpx;background:#edf1f6;color:#52647d;padding:12rpx 20rpx;border-radius:25rpx}.positive{color:#198364}.negative{color:#bd403b}.unread{width:14rpx;height:14rpx;border-radius:50%;background:#ee6a59;display:inline-block;margin-right:12rpx}
