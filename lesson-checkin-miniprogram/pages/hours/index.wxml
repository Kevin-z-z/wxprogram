<view class="page"><view class="title">课时明细</view><view class="muted">学生 小禾 · 课时变动记录</view><view class="grid gap"><view wx:for="{{courses}}" wx:key="id" class="card"><view class="muted">{{item.name}}</view><view class="number">{{item.balance}}</view><text class="tag">剩余课时</text></view></view><view class="section">变动记录</view><view wx:for="{{items}}" wx:key="id" class="card"><view class="row"><view class="subtitle">{{item.reason}}</view><text class="{{item.delta>0?'positive':'negative'}}">{{item.amount}} 课时</text></view><view class="muted gap">{{item.courseName}}</view><view class="muted">{{item.time}}</view><view class="muted" wx:if="{{item.sessionId}}">关联课次 {{item.sessionId}}</view></view></view>
