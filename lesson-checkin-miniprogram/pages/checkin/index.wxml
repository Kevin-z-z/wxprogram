<view class="page" wx:if="{{session}}"><view class="title">{{session.courseName}}</view><view class="muted">{{session.date}} · 学生 小禾</view><view class="card gap" wx:if="{{session.checkin}}"><view class="subtitle positive">本次课已完成打卡</view><view class="muted gap">{{session.checkin.time}}</view><view class="muted">最终考勤：{{session.studentStatus}}</view><image wx:if="{{session.checkin.photo}}" class="photo gap" src="{{session.checkin.photo}}" mode="aspectFit"/></view><view class="card gap" wx:elif="{{session.activity}}"><view class="subtitle">{{session.activityLabel}}</view><view class="notice">请按教师设置的方式完成打卡。活动开放后 30 分钟内有效。</view><block wx:if="{{session.activity.type==='photo'}}"><button bindtap="photo">现场拍摄照片</button><image wx:if="{{photo}}" class="photo gap" src="{{photo}}" mode="aspectFit"/></block><block wx:if="{{session.activity.type==='location'}}"><button bindtap="locate">获取当前位置</button><view class="muted gap">{{location?'位置已获取，提交时校验范围':'需在教师设置地点附近 200 米内'}}</view></block><button class="primary gap" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">提交打卡</button></view><view wx:else class="empty">教师尚未发起签到</view></view>
