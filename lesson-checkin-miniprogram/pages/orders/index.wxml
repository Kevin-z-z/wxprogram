<view class="page"><view class="title">订单与退款</view><view class="actions"><view class="pill {{tab==='all'?'selected':''}}" data-tab="all" bindtap="tab">全部订单</view><view class="pill {{tab==='refund'?'selected':''}}" data-tab="refund" bindtap="tab">退款记录</view></view><view class="notice">本期提供已有订单与退款查询，不执行支付和退款。</view><view wx:for="{{items}}" wx:key="id" class="card"><view class="row"><view class="subtitle">{{item.courseName}}</view><text class="tag">{{item.status}}</text></view><view class="muted gap">订单编号 {{item.id}}</view><view class="row split"><text>{{item.hours}} 课时</text><text>¥ {{item.amount}}</text></view><view class="muted gap">{{item.refund}}</view></view><view wx:if="{{!items.length}}" class="empty">暂无退款记录</view></view>
