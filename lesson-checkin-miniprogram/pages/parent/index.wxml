<view class="page"><view class="hero"><view class="row"><view class="muted">你好，{{user.name}}</view><text bindtap="logout">切换身份</text></view><view class="title gap">陪伴成长 轻松掌握</view><view class="muted">当前学生：小禾 · 剩余总课时</view><view class="number">{{total}} <text style="font-size:26rpx">课时</text></view></view><view class="grid"><view class="card" data-page="courses" bindtap="open"><view class="subtitle">全部课程</view><view class="muted gap">探索更多兴趣</view></view><view class="card" data-page="hours" bindtap="open"><view class="subtitle">课时明细</view><view class="muted gap">每笔变动可查询</view></view><view class="card" data-page="orders" bindtap="open"><view class="subtitle">订单与退款</view><view class="muted gap">查询已有记录</view></view><view class="card" data-page="leaves" bindtap="open"><view class="subtitle">请假记录</view><view class="muted gap">关注审批结果</view></view></view><view class="section">我的课程</view><view wx:for="{{courses}}" wx:key="id" class="card"><view class="row"><view class="subtitle">{{item.name}}</view><text class="tag">剩余 {{item.balance}} 课时</text></view><view class="muted gap">{{item.className}} · {{item.teacher}}</view></view><view class="section">近期上课</view><view wx:for="{{sessions}}" wx:key="id" class="card" data-page="session" data-id="{{item.id}}" bindtap="open"><view class="row"><view class="subtitle">{{item.courseName}}</view><text class="tag">查看课次</text></view><view class="muted gap">{{item.date}} {{item.time}}</view></view></view><role-nav role="parent" active="parent"/>
