<view class="page"><view class="title">{{role==='teacher'?'请假审批':'我的请假'}}</view><view class="muted">按课次提交，审批结果可追踪</view><view wx:for="{{items}}" wx:key="id" class="card gap"><view class="row"><view class="subtitle">{{item.courseName}}</view><text class="tag">{{item.statusLabel}}</text></view><view class="muted gap">小禾 · {{item.date}}</view><view class="gap">请假原因：{{item.reason}}</view><view wx:if="{{item.opinion}}" class="muted gap">审批意见：{{item.opinion}}</view><view class="actions" wx:if="{{item.status==='pending'}}"><block wx:if="{{role==='teacher'}}"><button class="primary small" data-id="{{item.id}}" data-decision="yes" bindtap="approve">批准</button><button class="danger small" data-id="{{item.id}}" data-decision="no" bindtap="approve">拒绝</button></block><button wx:else class="small" data-id="{{item.id}}" bindtap="cancel">撤销申请</button></view></view><view wx:if="{{!items.length}}" class="empty">暂无请假记录</view></view><role-nav role="{{role}}" active="leaves"/>
