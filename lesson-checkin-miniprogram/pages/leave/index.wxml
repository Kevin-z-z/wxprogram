<view class="page" wx:if="{{session}}"><view class="title">申请请假</view><view class="card gap"><view class="subtitle">{{session.courseName}}</view><view class="muted gap">学生：小禾</view><view class="muted">{{session.date}} {{session.time}}</view><view class="field"><view class="label">请假原因</view><textarea placeholder="请填写请假原因" maxlength="200" value="{{reason}}" bindinput="input"/></view><button class="primary" bindtap="submit">提交请假申请</button></view><view class="notice">请在上课开始前申请。提交后需等待教师审批，批准后本次课程不扣课时。</view></view>
