<view class="page"><view class="hero"><view class="row"><text class="muted">陈老师 · 教师工作台</text><text bindtap="logout">切换身份</text></view><view class="title gap">专注课堂 从容教学</view><view class="muted">创意美术基础 · 周末美术 A 班</view></view><view class="grid"><view class="card" bindtap="leaves"><view class="muted">待审批请假</view><view class="number">{{pending}}</view></view><view class="card"><view class="muted">待结算课次</view><view class="number">{{unsettled}}</view></view></view><view class="section">我负责的课程</view><view wx:for="{{sessions}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="row"><view class="subtitle">{{item.courseName}}</view><text class="tag">{{item.settled?'已结算':'待处理'}}</text></view><view class="muted gap">{{item.date}} {{item.time}} · {{item.location}}</view><view class="row split"><text>应到 {{item.expected}} 人</text><text>出勤 {{item.present}} 人</text><text>请假 {{item.leaveCount}} 人</text></view><button class="primary gap">进入课堂</button></view></view><role-nav role="teacher" active="teacher"/>
