<view class="page" wx:if="{{session}}"><view class="hero"><view class="tag">{{session.settled?'已结算':'未结算'}}</view><view class="title gap">{{session.courseName}}</view><view class="muted">{{session.date}} {{session.time}}</view><view class="muted">{{session.location}} · {{session.teacher}} · {{session.hours}} 课时</view></view><view wx:if="{{role==='parent'}}"><view class="card"><view class="row"><text>本次考勤</text><text class="tag">{{session.studentStatus}}</text></view><view class="muted gap">{{session.activityLabel}}</view><view class="muted" wx:if="{{session.checkin}}">已于 {{session.checkin.time}} 打卡</view><view class="actions"><button class="primary" bindtap="checkin" disabled="{{!session.activity || session.settled}}">{{session.checkin?'查看打卡':'参与打卡'}}</button><button bindtap="leave" disabled="{{session.settled}}">申请请假</button></view></view><view class="notice">签到不直接扣课时，由教师核对考勤后确认消课。</view></view><view wx:else><view class="card"><view class="subtitle">发起签到活动</view><view class="muted gap">{{session.activityLabel}} · 活动发布后开放 30 分钟</view><picker range="{{types}}" value="{{typeIndex}}" bindchange="type"><view class="picker gap">{{types[typeIndex]}} ▾</view></picker><button class="primary gap" bindtap="publish" disabled="{{session.settled}}">{{session.activity?'重新发布活动':'开放签到'}}</button><view class="muted gap" wx:if="{{typeIndex===2}}">以教师当前位置为中心，允许距离 200 米。</view></view><view class="section">学生名单 · 应到 {{session.expected}} 人</view><view wx:for="{{session.students}}" wx:key="id" class="card"><view class="row"><text class="subtitle">{{item.name}}</text><text class="tag">{{item.statusLabel}}</text></view><view class="actions" wx:if="{{session.settled ? false : item.status!=='leave'}}"><button class="small" data-sid="{{item.id}}" data-status="present" bindtap="mark">标记出勤</button><button class="small danger" data-sid="{{item.id}}" data-status="absent" bindtap="mark">标记缺席</button></view></view><button class="primary" bindtap="settle" disabled="{{session.settled || busy}}" loading="{{busy}}">{{session.settled?'本次课已结算':'核对完成 确认消课'}}</button><view class="notice">结算后只读。课后更正与返还流程作为后续功能，本骨架暂不开放。</view></view></view>
